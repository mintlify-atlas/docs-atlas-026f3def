  "keyFeatures": [
    "Drop-in authkitLoader for automatic session management and token refresh in React Router loaders",
    "PKCE + CSRF protection on all OAuth authorization-code flows",
    "Public (keyless) client mode — sign-in without a server-held API key",
    "Encrypted, HttpOnly cookie-based session storage with configurable or custom storage backends",
    "Feature Flags runtime client for server-side flag evaluation independent of JWT claims",
    "Organization switching with refreshSession",
    "Fine-grained auth data: user, sessionId, organizationId, role, roles, permissions, entitlements, featureFlags, impersonator",
    "ensureSignedIn option to enforce authentication and redirect anonymous users automatically",
    "Debug logging via the debug option on authkitLoader",
    "Flexible configuration via environment variables, programmatic configure(), or a custom value source"
  ],
  "publicApiSurface": [
    "authkitLoader(loaderArgs, loaderOrOptions?, options?)",
    "authLoader(options?)",
    "withAuth(args)",
    "getSignInUrl(returnPathname?, request?)",
    "getSignUpUrl(returnPathname?, request?)",
    "signOut(request, options?)",
    "switchToOrganization(request, organizationId, options?)",
    "configure(configOrSource, source?)",
    "getConfig(key)",
    "saveSession(sessionOrResponse, request)",
    "refreshSession(request, options?)",
    "getWorkOS()",
    "getFeatureFlagsRuntimeClient(options?)",
    "AuthKitConfig (type)",
    "AuthKitConfidentialConfig (type)",
    "AuthKitPublicConfig (type)"
  ]
}
